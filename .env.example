# Base URL of the Django backend's REST API (see the memory-map repo).
# Defaults to http://10.0.2.2:8002/api/v1, which only works from the Android
# emulator. Use your machine's LAN IP for a physical device or iOS simulator,
# e.g. http://192.168.1.42:8002/api/v1
API_URL=http://10.0.2.2:8002/api/v1

# Only needed if you want Google's map tiles/places instead of the default
# OpenStreetMap-based map.
GOOGLE_MAPS_API_KEY=
