# Copy to .env for local development. For store builds, set these in the
# matching eas.json profile instead.

# The Memory Map backend (the memory-map repo) - its root URL, no /api/v1.
# Android emulator: http://10.0.2.2:8002   iOS simulator: http://localhost:8002
# Physical phone: your computer's LAN IP, e.g. http://192.168.1.20:8002
EXPO_PUBLIC_API_URL=http://10.0.2.2:8002

# Shown as "Contact support" in the app. Leave empty to hide it.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Your own reverse-DNS app id (must be unique on the App Store / Play Store).
APP_BUNDLE_ID=com.memorymap.app
